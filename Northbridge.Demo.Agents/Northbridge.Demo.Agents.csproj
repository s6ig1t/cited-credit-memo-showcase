<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Northbridge.Demo.Agents</RootNamespace>
  </PropertyGroup>

  <!--
    Microsoft.Agents.AI.Abstractions and Microsoft.Extensions.AI (which supply AIAgent's
    underlying types like ChatMessage, TextContent, DataContent used in ExtractionAgent/
    MemoAgent) come in transitively through the packages below, confirmed by removing them and
    rebuilding successfully. No point referencing a package explicitly when another dependency
    already guarantees it's there; it's one less version number to keep in sync.

    Both provider connectors, Anthropic and OpenAI, are referenced unconditionally here. Which
    one actually gets used is a runtime decision (see LlmAgentFactory), not a compile-time one,
    so both have to be present in the build regardless of what a given deployment ends up
    selecting.

    Microsoft.Agents.AI.OpenAI, unlike the Anthropic connector, ships as a plain stable
    release rather than a preview build, confirmed against the installed package version.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Agents.AI" Version="1.21.0" />
    <PackageReference Include="Microsoft.Agents.AI.Anthropic" Version="1.21.0-preview.260911.1" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.21.0" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      References Core ONLY, same discipline as Analysis. This project talks to Claude and
      builds structured results from what comes back; it does not do financial arithmetic,
      that stays in Analysis. Agents and Analysis both depend on Core, but never on each other,
      which is what keeps "the part that calls an LLM" and "the part that does math" fully
      decoupled at the project-reference level, not just by convention.
    -->
    <ProjectReference Include="..\Northbridge.Demo.Core\Northbridge.Demo.Core.csproj" />
  </ItemGroup>

</Project>
