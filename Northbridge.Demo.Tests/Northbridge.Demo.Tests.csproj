<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Northbridge.Demo.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Tests references BOTH Core and Analysis, but deliberately nothing from Agents or Api.
      At this stage of the project, only Analysis has anything worth unit testing: it's
      pure, deterministic C# with no external dependencies to mock. Once the Claude adapter
      and agents exist, we'll decide separately whether they need integration-style tests
      (they will, but of a different kind, since they involve a real network call).
    -->
    <ProjectReference Include="..\Northbridge.Demo.Core\Northbridge.Demo.Core.csproj" />
    <ProjectReference Include="..\Northbridge.Demo.Analysis\Northbridge.Demo.Analysis.csproj" />
  </ItemGroup>

</Project>
